{
  "name": "cim-trainer",
  "private": true,
  "description": "npm tooling for automated tests, changelog compilation, and the Capacitor-based Android app; the website itself has no npm build step.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:news": "node scripts/update_changelog.mjs build",
    "screenshots:store": "node scripts/update_store_screenshots.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@playwright/test": "1.61.1",
    "http-server": "14.1.1",
    "playwright": "1.61.1"
  }
}
